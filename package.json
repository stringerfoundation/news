{
  "name": "stringer-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --import tsx --test tests/*.test.mjs deploy/homepage-worker/worker.test.mjs",
    "test:browser": "node --test tests/browser.spec.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:relay": "tsx --test tests/relay/*.test.ts",
    "test:relay-browser": "tsx --test tests/relay/*.browser.ts",
    "test:artifact": "node --test tests/artifact/*.test.mjs",
    "test:coverage": "c8 --100 --per-file node tests/coverage/run.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "c8": {
    "all": true,
    "include": [
      "*.js",
      "relay/*.ts",
      "scripts/*.mjs",
      "deploy/*/worker.mjs",
      "_site/relay-reader.js"
    ],
    "exclude": [
      "eslint.config.js",
      "relay/types.ts"
    ],
    "reporter": [
      "text",
      "html",
      "json",
      "json-summary"
    ],
    "tempDirectory": ".test-output/coverage/tmp",
    "reports-dir": ".test-output/coverage",
    "excludeAfterRemap": true
  }
}
