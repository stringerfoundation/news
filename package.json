{
  "name": "stringer-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts deploy/homepage-worker/worker.test.ts",
    "test:browser": "node --test tests/browser.spec.ts tests/portuguese.browser.ts tests/multilingual.browser.ts",
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1",
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
