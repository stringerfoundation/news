{
  "name": "stringer-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.mjs deploy/homepage-worker/worker.test.mjs",
    "test:browser": "node --test tests/browser.spec.mjs tests/previews.browser.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:relay": "tsx --test tests/relay/*.test.ts",
    "test:relay-browser": "tsx --test tests/relay/*.browser.ts",
    "test:artifact": "node --test tests/artifact/*.test.mjs",
    "test:previews": "python3 -B -m unittest discover -s tests/previews -p '*_test.py'"
  },
  "dependencies": {
    "nostr-tools": "2.25.2",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  }
}
