{
  "name": "stringer-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node --check app.js && node --check news-model.js && node --check stringer-media.js && node --check deploy/homepage-worker/worker.mjs",
    "test": "node --test tests/*.test.mjs deploy/homepage-worker/worker.test.mjs",
    "test:browser": "node --test tests/browser.spec.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "nostr-tools": "2.25.2",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
